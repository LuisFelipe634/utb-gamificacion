// ============================================
// UTB Gamificación - Schema de Base de Datos
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// MODELOS DE USUARIO Y AUTENTICACIÓN
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(STUDENT)
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  points         Point[]
  missions       StudentMission[]
  badges         StudentBadge[]
  notifications  Notification[]
  activities     Activity[]

  @@map("users")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

// ============================================
// PERFILES POR ROL
// ============================================

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  studentCode     String   @unique  // Código universitario
  programId       String
  currentSemester Int      @default(1)
  admissionYear   Int
  totalCredits    Int      @default(0)
  averageGrade    Float    @default(0.0)
  level           Int      @default(1)  // Nivel académico actual

  // Relaciones
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program         Program  @relation(fields: [programId], references: [id])
  enrollments     Enrollment[]
  academicHistory AcademicRecord[]
  recommendations Recommendation[]

  @@map("student_profiles")
}

model TeacherProfile {
  id       String @id @default(cuid())
  userId   String @unique
  department String?
  title    String?

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

// ============================================
// MODELOS ACADÉMICOS (MALLA CURRICULAR)
// ============================================

model Program {
  id          String   @id @default(cuid())
  code        String   @unique  // Ej: ISCO, IINF
  name        String
  totalCredits Int
  totalSemesters Int
  version     String   // Versión del plan de estudios
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Relaciones
  courses     Course[]
  students    StudentProfile[]
  semesters   Semester[]

  @@map("programs")
}

model Semester {
  id          String  @id @default(cuid())
  programId   String
  number      Int     // Número del semestre (1-10)
  name        String? // Nombre opcional del semestre

  program     Program @relation(fields: [programId], references: [id])
  courses     Course[]

  @@unique([programId, number])
  @@map("semesters")
}

model Course {
  id              String   @id @default(cuid())
  code            String   @unique  // Ej: MAT101, PROG101
  name            String
  credits         Int
  programId       String
  semesterId      String
  type            CourseType @default(OBLIGATORIO)
  description     String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  // Relaciones
  program         Program  @relation(fields: [programId], references: [id])
  semester        Semester @relation(fields: [semesterId], references: [id])
  prerequisites   Prerequisite[] @relation("CoursePrerequisites")
  requiredBy      Prerequisite[] @relation("RequiredForCourse")
  enrollments     Enrollment[]
  missions        Mission[]

  @@map("courses")
}

enum CourseType {
  OBLIGATORIO
  ELECTIVA
  LIBRE_ELECCION
  GENERAL
}

model Prerequisite {
  id            String  @id @default(cuid())
  courseId       String  // Curso que requiere el prerrequisito
  prerequisiteId String // Curso prerrequisito
  type          PrerequisiteType @default(REQUIRED)

  course        Course @relation("CoursePrerequisites", fields: [courseId], references: [id])
  prerequisite  Course @relation("RequiredForCourse", fields: [prerequisiteId], references: [id])

  @@unique([courseId, prerequisiteId])
  @@map("prerequisites")
}

enum PrerequisiteType {
  REQUIRED    // Prerrequisito obligatorio
  COREQUISITE // Correquisito (se puede ver en paralelo)
}

// ============================================
// MODELOS DE PROGRESO ESTUDIANTIL
// ============================================

model Enrollment {
  id          String         @id @default(cuid())
  studentId   String
  courseId     String
  semesterCode String        // Código del periodo (ej: 2024-1)
  status      EnrollmentStatus @default(INSCRITO)
  grade       Float?
  statusDetail String?       // Detalle del estado (APROBADO, REPROBADO, etc.)

  student     StudentProfile @relation(fields: [studentId], references: [id])
  course      Course         @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId, semesterCode])
  @@map("enrollments")
}

enum EnrollmentStatus {
  INSCRITO
  CURSANDO
  APROBADO
  REPROBADO
  RETIRADO
  CANCELADO
}

model AcademicRecord {
  id          String         @id @default(cuid())
  studentId   String
  courseCode   String
  courseName   String
  grade       Float
  semester    Int
  year        Int
  status      AcademicStatus
  credits     Int
  importedAt  DateTime @default(now())

  student     StudentProfile @relation(fields: [studentId], references: [id])

  @@map("academic_records")
}

enum AcademicStatus {
  APROBADO
  REPROBADO
  EN_CURSO
  PENDIENTE
}

// ============================================
// MODELOS DE GAMIFICACIÓN
// ============================================

model Point {
  id          String    @id @default(cuid())
  userId      String
  amount      Int
  source      PointSource
  description String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@map("points")
}

enum PointSource {
  MISION_COMPLETADA
  RENDIMIENTO_ACADEMICO
  MEJORA_PROMEDIO
  CONSISTENCIA
  IMPACTO_SOCIAL
  EVENTO_ESPECIAL
}

model Mission {
  id            String       @id @default(cuid())
  title         String
  description   String
  type          MissionType
  pointsReward  Int
  courseId       String?
  requiredLevel Int?         // Nivel mínimo requerido
  isActive      Boolean      @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime     @default(now())

  course        Course?      @relation(fields: [courseId], references: [id])
  students      StudentMission[]

  @@map("missions")
}

enum MissionType {
  ACADEMICO
  PLANIFICACION
  MEJORA_CONTINUA
  IMPACTO_SOCIAL
  HABITO_ESTUDIO
}

model StudentMission {
  id          String       @id @default(cuid())
  studentId   String
  missionId   String
  status      MissionStatus @default(PENDIENTE)
  progress    Int          @default(0)  // 0-100
  completedAt DateTime?
  evidence    String?      // URL o descripción de evidencia
  verifiedBy  String?
  verifiedAt  DateTime?
  reviewComment String?
  createdAt   DateTime     @default(now())

  student     User         @relation(fields: [studentId], references: [id])
  mission     Mission      @relation(fields: [missionId], references: [id])

  @@unique([studentId, missionId])
  @@map("student_missions")
}

enum MissionStatus {
  PENDIENTE
  EN_PROGRESO
  EN_REVISION
  COMPLETADA
  VERIFICADA
  RECHAZADA
}

model Badge {
  id            String    @id @default(cuid())
  name          String
  description   String
  iconUrl       String
  category      BadgeCategory
  requiredLevel Int?
  pointsRequired Int?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  students      StudentBadge[]

  @@map("badges")
}

enum BadgeCategory {
  PROGRESO
  COMPETENCIA
  HABITO
  IMPACTO_SOCIAL
  RENDIMIENTO
}

model StudentBadge {
  id          String    @id @default(cuid())
  studentId   String
  badgeId     String
  earnedAt    DateTime  @default(now())
  evidence    String?
  verifiedBy  String?   // ID del verificador

  user        User      @relation(fields: [studentId], references: [id])
  badge       Badge     @relation(fields: [badgeId], references: [id])

  @@unique([studentId, badgeId])
  @@map("student_badges")
}

model Level {
  id          String @id @default(cuid())
  number      Int    @unique
  name        String
  minPoints   Int
  description String?
  iconUrl     String?

  @@map("levels")
}

// ============================================
// MODELOS DE NOTIFICACIONES Y ACTIVIDADES
// ============================================

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  message     String
  type        NotificationType
  isRead      Boolean   @default(false)
  link        String?   // Enlace a la acción relevante
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@map("notifications")
}

enum NotificationType {
  INFO
  WARNING
  ALERTA_RIESGO
  LOGRO_OBTENIDO
  MISION_DISPONIBLE
  RECORDATORIO
}

model Activity {
  id          String    @id @default(cuid())
  userId      String
  action      String
  details     Json?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@map("activities")
}

// ============================================
// MODELO DE RECOMENDACIONES
// ============================================

model Recommendation {
  id          String    @id @default(cuid())
  studentId   String
  type        RecommendationType
  title       String
  description String
  priority    Int       @default(1)  // 1=alta, 2=media, 3=baja
  isRead      Boolean   @default(false)
  isAccepted  Boolean?
  createdAt   DateTime  @default(now())

  student     StudentProfile @relation(fields: [studentId], references: [id])

  @@map("recommendations")
}

enum RecommendationType {
  CURSO_SUGERIDO
  RUTA_ACademica
  ALERTA_ATRASO
  MEJORA_PROMEDIO
  ELECTIVA_RECOMENDADA
}

// ============================================
// MODELO DE ALERTAS DE RIESGO
// ============================================

model RiskAlert {
  id          String    @id @default(cuid())
  studentId   String
  type        RiskAlertType
  severity    RiskSeverity
  title       String
  description String
  courseId     String?   // Curso relacionado si aplica
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("risk_alerts")
}

enum RiskAlertType {
  PREREQUISITO_FALTANTE
  ATRASO_CREDITOS
  BAJO_PROMEDIO
  CURSO_EN_RIESGO
  SEMESTRE_RETRASADO
}

enum RiskSeverity {
  BAJA
  MEDIA
  ALTA
  CRITICA
}
